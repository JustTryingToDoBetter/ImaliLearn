@page "/"
@inject NavigationManager Navigation

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 text-center">
            <h1 class="display-4 mb-4">
                <i class="bi bi-wallet2 text-primary"></i>
                Welcome to ImaliLearn
            </h1>
            <p class="lead text-muted mb-5">
                Your personal financial education and budgeting companion. 
                Take control of your finances with smart budgeting tools.
            </p>
            
            <AuthorizeView>
                <Authorized>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="/budgets" class="btn btn-primary btn-lg">
                            <i class="bi bi-piggy-bank me-2"></i>View Budgets
                        </a>
                        <a href="/create-budget" class="btn btn-outline-primary btn-lg">
                            <i class="bi bi-plus-circle me-2"></i>Create Budget
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="d-flex justify-content-center gap-3">
                        <a href="/login" class="btn btn-primary btn-lg">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                        </a>
                        <a href="/register" class="btn btn-outline-success btn-lg">
                            <i class="bi bi-person-plus me-2"></i>Register
                        </a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
            
            <hr class="my-5" />
            
            <div class="row text-start">
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-graph-up-arrow display-4 text-success mb-3"></i>
                            <h5>Track Spending</h5>
                            <p class="text-muted small">Monitor your expenses and stay on track with your financial goals.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-piggy-bank display-4 text-primary mb-3"></i>
                            <h5>Create Budgets</h5>
                            <p class="text-muted small">Set up budgets for different categories and time periods.</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center">
                            <i class="bi bi-shield-check display-4 text-info mb-3"></i>
                            <h5>Secure & Private</h5>
                            <p class="text-muted small">Your financial data is protected with industry-standard security.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
