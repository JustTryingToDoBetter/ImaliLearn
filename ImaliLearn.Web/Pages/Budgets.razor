@page "/budgets"
@using ImaliLearn.Web.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject BudgetService BudgetService
@inject NavigationManager Navigation

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-piggy-bank me-2"></i>My Budgets</h2>
        <a href="/create-budget" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Create Budget
        </a>
    </div>

    @if (_isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading budgets...</p>
        </div>
    }
    else if (_error != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>@_error
        </div>
    }
    else if (_budgets.Count == 0)
    {
        <div class="card text-center py-5">
            <div class="card-body">
                <i class="bi bi-folder-x display-3 text-muted"></i>
                <h4 class="mt-3">No Budgets Yet</h4>
                <p class="text-muted">Start tracking your finances by creating your first budget.</p>
                <a href="/create-budget" class="btn btn-primary">
                    <i class="bi bi-plus-circle me-1"></i>Create Your First Budget
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var budget in _budgets)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@budget.Name</h5>
                            @if (!string.IsNullOrEmpty(budget.Description))
                            {
                                <p class="card-text text-muted small">@budget.Description</p>
                            }
                            
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small>Spent</small>
                                    <small>@budget.SpentAmount.ToString("C") / @budget.TotalAmount.ToString("C")</small>
                                </div>
                                @{
                                    var percentage = budget.TotalAmount > 0 
                                        ? Math.Min((budget.SpentAmount / budget.TotalAmount) * 100, 100) 
                                        : 0;
                                    var progressClass = percentage >= 90 ? "bg-danger" 
                                        : percentage >= 70 ? "bg-warning" 
                                        : "bg-success";
                                }
                                <div class="progress" style="height: 10px;">
                                    <div class="progress-bar @progressClass" role="progressbar" 
                                         style="width: @percentage%;" 
                                         aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between text-muted small">
                                <span><i class="bi bi-calendar me-1"></i>@budget.StartDate.ToString("MMM d")</span>
                                <span>to</span>
                                <span>@budget.EndDate.ToString("MMM d, yyyy")</span>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top-0">
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-outline-danger btn-sm" 
                                        @onclick="() => DeleteBudgetAsync(budget.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<BudgetDto> _budgets = new();
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadBudgetsAsync();
    }

    private async Task LoadBudgetsAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            _budgets = await BudgetService.GetBudgetsAsync();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load budgets: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DeleteBudgetAsync(Guid id)
    {
        var (success, error) = await BudgetService.DeleteBudgetAsync(id);
        
        if (success)
        {
            await LoadBudgetsAsync();
        }
        else
        {
            _error = error;
        }
    }
}
